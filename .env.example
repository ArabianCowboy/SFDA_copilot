# ============================================
# SFDA Copilot - Environment Variables
# ============================================
# This file contains SECRETS and ENVIRONMENT-SPECIFIC settings only.
# Application behavior settings are in web/config.yaml
#
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
# ============================================

# --- API Keys (Required) ---
OPENAI_API_KEY=sk-your-openai-api-key-here

# --- Supabase (Required) ---
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_PROJECT_REF=your-project-ref

# --- Flask Security (Required for Production) ---
FLASK_SECRET_KEY=generate-a-secure-random-string-here

# --- Deployment Environment ---
# Set to 'true' when deployed behind a reverse proxy (Nginx with SSL)
BEHIND_PROXY=false
