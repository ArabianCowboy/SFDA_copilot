# ============================================
# SFDA Copilot - Environment Variables
# ============================================
# This file contains SECRETS and ENVIRONMENT-SPECIFIC settings only.
# Application behavior settings are in web/config.yaml
#
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
# ============================================

# --- API Keys (Required) ---
OPENAI_API_KEY=sk-your-openai-api-key-here

# --- Supabase (Required) ---
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_PROJECT_REF=your-project-ref

# --- Supabase secret key (Optional; required for the admin surface) ---
# SERVER-SIDE ONLY. This key bypasses every RLS policy on the project: it must
# never be rendered into a template, returned in a response, or committed.
#
# Without it the app runs normally and every reader resolves as a
# non-administrator, so the admin surface is simply unreachable. That is the
# safe direction, and it is a supported way to deploy.
#
# PREFER the new key. Supabase is replacing the long-lived JWT `service_role`
# key with `sb_secret_…` keys that can be revoked individually, and removes the
# legacy ones in late 2026. It matters most for this key: rotating a leaked
# `service_role` means rotating the project's JWT secret, which invalidates the
# anon key and every live session at the same time. A secret key you just delete.
#
# Project Settings -> API Keys -> Secret keys -> Create
# SUPABASE_SECRET_KEY=sb_secret_...
#
# Legacy fallback, used only when SUPABASE_SECRET_KEY is unset. Same privileges,
# no revocation story. Project Settings -> API Keys -> Legacy -> service_role
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Flask Security (Required for Production) ---
FLASK_SECRET_KEY=generate-a-secure-random-string-here

# --- Deployment Environment ---
# Set to 'true' when deployed behind a reverse proxy (Nginx with SSL)
BEHIND_PROXY=false
