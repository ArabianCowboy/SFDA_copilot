# ============================================
# SFDA Copilot - Environment Variables
# ============================================
# This file contains SECRETS and ENVIRONMENT-SPECIFIC settings only.
# Application behavior settings are in web/config.yaml
#
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
# ============================================

# --- API Keys (Required) ---
OPENAI_API_KEY=sk-your-openai-api-key-here

# --- Supabase (Required) ---
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_PROJECT_REF=your-project-ref

# --- Supabase secret key (Optional; required for the admin surface) ---
# SERVER-SIDE ONLY. This key bypasses every RLS policy on the project: it must
# never be rendered into a template, returned in a response, or committed.
#
# Without it the app runs normally and every reader resolves as a
# non-administrator, so the admin surface is simply unreachable. That is the
# safe direction, and it is a supported way to deploy.
#
# PREFER the new key. Supabase is replacing the long-lived JWT `service_role`
# key with `sb_secret_…` keys that can be revoked individually, and removes the
# legacy ones in late 2026. It matters most for this key: rotating a leaked
# `service_role` means rotating the project's JWT secret, which invalidates the
# anon key and every live session at the same time. A secret key you just delete.
#
# Project Settings -> API Keys -> Secret keys -> Create
# SUPABASE_SECRET_KEY=sb_secret_...
#
# Legacy fallback, used only when SUPABASE_SECRET_KEY is unset. Same privileges,
# no revocation story. Project Settings -> API Keys -> Legacy -> service_role
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Flask Security (Required for Production) ---
FLASK_SECRET_KEY=generate-a-secure-random-string-here

# --- Deployment Environment ---
# Set to 'true' when deployed behind a reverse proxy (Nginx with SSL)
BEHIND_PROXY=false

# --- Public base URL (required for password recovery) ---
#
# Where a password-recovery link comes back to. Built into the email GoTrue
# sends, so this is the address a locked-out reader is told to click.
#
# Read from here and NEVER from `request.host_url`: the Host header is
# attacker-controlled, and a poisoned Host would mail readers a recovery link
# pointing somewhere else. Not knowing our own address is a reason to refuse to
# send, which is what the app does — `POST /auth/recover` still answers the
# generic 202, because a misconfiguration must not be distinguishable from an
# unknown address, and logs `recovery unavailable (reset_not_configured)`.
#
# Must be a bare origin: scheme + host + optional port, no trailing path, no
# query, no fragment, no credentials. http is accepted so local development
# works; https everywhere else.
#
# Whatever you put here must ALSO be on Supabase's redirect allow-list
# (Authentication -> URL Configuration -> Redirect URLs) or the link silently
# falls back to the Site URL. Add it with a wildcard so the query survives:
#   http://127.0.0.1:5000/**
#   https://sfda-copilot.aifoudahub.com/**
PUBLIC_BASE_URL=http://127.0.0.1:5001
