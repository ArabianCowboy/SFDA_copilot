[Unit]
Description=SFDA Copilot transcript-orphan check (one shot, read-only)
After=network.target

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/var/www/sfda-copilot
Environment=PATH=/var/www/sfda-copilot/venv/bin
EnvironmentFile=/var/www/sfda-copilot/.env
ExecStart=/var/www/sfda-copilot/venv/bin/python -m scripts.check_transcript_orphans --quiet
